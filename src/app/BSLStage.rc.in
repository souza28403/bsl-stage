#include <winver.h>

1 ICON "@BSL_ICON_RC@"

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BSL Light"
            VALUE "FileDescription", "@BSL_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "@BSL_RC_INTERNAL@"
            VALUE "LegalCopyright", "Copyright (C) 2026 BSL Light - GPL-3.0"
            VALUE "OriginalFilename", "@BSL_RC_INTERNAL@.exe"
            VALUE "ProductName", "BSL Stage"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
